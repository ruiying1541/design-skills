---
import Layout from '../layouts/Layout.astro';

const updates = [
  {
    date: '2026.07.23',
    label: 'NEW SKILL',
    title: '中东主题头像框 Skill 上线',
    summary: '新增中东、开斋节与阿拉伯宫廷主题头像框生成工作流，并加入真实四宫格效果案例。',
    items: [
      '支持低价款、中价款和高价款三档复杂度',
      '规范中心头像留白、环形结构、主题元素与材质层级',
      '支持主题生成、参考图转译、先出方案和独立资源输出',
      '加入新月、灯笼、神灯、宫殿拱门和宝石等中东主题元素库',
      '详情页展示 4 款 3D 金属宝石风实际生成结果',
    ],
    href: '/design-skills/skills/middle-east-avatar-frame',
    linkLabel: '查看 Skill',
  },
  {
    date: '2026.07.23',
    label: 'NEW SKILL',
    title: 'Humanizer 去 AI 味上线',
    summary: '新增文本自然化与 AI 写作痕迹审查 Skill，在保留事实与原意的前提下，让表达更接近真实写作。',
    items: [
      '覆盖内容、语言、风格、沟通与填充表达等 33 类检查模式',
      '支持根据用户写作样本校准个人语气',
      '加入禁止编造事实、姓名、日期、数字与引用的改写边界',
      '提供 Skills CLI、Claude Code 插件和文件处理方式',
      '完成站内检索与相关 Skill 关联',
    ],
    href: '/design-skills/skills/humanizer',
    linkLabel: '查看 Skill',
  },
  {
    date: '2026.07.23',
    label: 'NEW SKILL',
    title: '归藏 PPT Skill 上线',
    summary: '新增面向 Claude Code、Codex 等 Agent 的网页 PPT 工作流，并为详情页加入可点击的瑞士风效果预览。',
    items: [
      '新增电子杂志风与瑞士国际主义双视觉系统介绍',
      '提供安装命令、触发场景、标准工作流与输出规格',
      '接入「从 Prompt 到 Skill」16 页在线演示',
      '详情页新增 16:9 效果展示组件并完成移动端适配',
      '更新站内搜索索引',
    ],
    href: '/design-skills/skills/guizang-ppt-skill',
    linkLabel: '查看 Skill',
  },
  {
    date: '2026.07.13',
    label: 'CONTENT',
    title: 'Design AI Skill 系列扩充',
    summary: '新增 12 个设计 AI Skill，并补充测试案例、效果素材和发布排序。',
    items: [
      '新增通用图像生成、抠图、扩图、格式转换等设计工具',
      '新增 PPT、信息图、竞品分析、流程图与报告生成能力',
      '优化图片型测试案例表格与详情页素材展示',
      '新增按发布时间查看最新 Skill 的排序方式',
    ],
  },
  {
    date: '2026.07.03',
    label: 'LAUNCH',
    title: 'Design Skills 平台发布',
    summary: '设计师与 AI Agent 双栖的 Skill 工作台正式上线。',
    items: [
      '上线 Skill 分类、搜索、详情与一键复制能力',
      '接入 GitHub 精选设计 Skill',
      '提供 skills-index.json 供 AI Agent 读取',
      '完成 GitHub Pages 部署和站点基础配置',
    ],
  },
];
---

<Layout title="更新记录 — Design Skills" description="Design Skills 平台的新增 Skill、功能优化与内容更新记录。">
  <section style="max-width: 900px; margin: 0 auto; padding: 64px 24px 96px;">
    <div style="max-width: 620px; margin-bottom: 48px;">
      <p style="font-size: 11px; font-weight: 600; letter-spacing: .14em; color: #002FA7; font-family: 'DM Mono', monospace; margin-bottom: 12px;">CHANGELOG</p>
      <h1 style="font-size: clamp(30px, 5vw, 46px); line-height: 1.1; letter-spacing: -.04em; margin-bottom: 14px;">更新记录</h1>
      <p style="font-size: 15px; line-height: 1.75; color: #737373;">记录平台新增的 Skill、体验优化与内容迭代。每一次更新，都让设计工作流更容易被复用。</p>
    </div>

    <div style="position: relative;">
      <div style="position: absolute; left: 95px; top: 8px; bottom: 12px; width: 1px; background: #E5E5E5;" class="timeline-line"></div>
      {updates.map((update, index) => (
        <article class="update-row" style={`display: grid; grid-template-columns: 72px 1fr; gap: 48px; position: relative; ${index < updates.length - 1 ? 'padding-bottom: 52px;' : ''}`}>
          <time style="font-size: 12px; color: #737373; font-family: 'DM Mono', monospace; padding-top: 4px; white-space: nowrap;">{update.date}</time>
          <span style="position: absolute; left: 90px; top: 7px; width: 11px; height: 11px; border-radius: 50%; background: #fff; border: 3px solid #002FA7; z-index: 1;" class="timeline-dot"></span>
          <div style="min-width: 0;">
            <div style="display: inline-flex; align-items: center; font-size: 10px; font-weight: 700; letter-spacing: .1em; color: #002FA7; background: #E8EEFF; border-radius: 20px; padding: 3px 9px; font-family: 'DM Mono', monospace; margin-bottom: 10px;">{update.label}</div>
            <h2 style="font-size: 22px; line-height: 1.3; letter-spacing: -.025em; margin-bottom: 8px;">{update.title}</h2>
            <p style="font-size: 14px; line-height: 1.75; color: #737373; margin-bottom: 16px;">{update.summary}</p>
            <ul style="display: grid; gap: 8px; list-style: none; margin: 0; padding: 0;">
              {update.items.map(item => (
                <li style="display: flex; gap: 9px; font-size: 13px; line-height: 1.6; color: #404040;">
                  <span style="color: #002FA7; font-weight: 700; flex: 0 0 auto;">→</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
            {update.href && (
              <a href={update.href} style="display: inline-flex; align-items: center; gap: 5px; color: #002FA7; font-size: 13px; font-weight: 600; text-decoration: none; margin-top: 18px;">
                {update.linkLabel} <span>↗</span>
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <style>
    @media (max-width: 600px) {
      .timeline-line { left: 5px !important; }
      .update-row { grid-template-columns: 1fr !important; gap: 10px !important; padding-left: 28px; }
      .timeline-dot { left: 0 !important; }
    }
  </style>
</Layout>
