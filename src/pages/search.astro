---
import Layout from '../layouts/Layout.astro';
---

<Layout title="搜索 Skill">
  <div class="max-w-4xl mx-auto px-6 py-16">
    <div class="mb-10">
      <h1 class="text-3xl font-bold text-white mb-3">搜索 Skill</h1>
      <p class="text-white/50">在所有设计 Skill 中快速检索你需要的内容</p>
    </div>

    <div id="search" class="pagefind-search"></div>
  </div>
</Layout>

<!-- Pagefind UI 样式覆盖 -->
<style is:global>
  .pagefind-ui__search-input {
    background: rgba(255,255,255,0.04) !important;
    border: 1px solid rgba(255,255,255,0.15) !important;
    color: white !important;
    border-radius: 12px !important;
    padding: 12px 16px !important;
    font-size: 16px !important;
  }
  .pagefind-ui__search-input:focus {
    border-color: rgba(99,102,241,0.6) !important;
    outline: none !important;
    box-shadow: 0 0 0 3px rgba(99,102,241,0.15) !important;
  }
  .pagefind-ui__search-input::placeholder {
    color: rgba(255,255,255,0.3) !important;
  }
  .pagefind-ui__result {
    background: rgba(255,255,255,0.03) !important;
    border: 1px solid rgba(255,255,255,0.1) !important;
    border-radius: 12px !important;
    padding: 16px !important;
    margin-bottom: 12px !important;
  }
  .pagefind-ui__result:hover {
    border-color: rgba(255,255,255,0.25) !important;
    background: rgba(255,255,255,0.06) !important;
  }
  .pagefind-ui__result-title {
    color: white !important;
    font-weight: 600 !important;
  }
  .pagefind-ui__result-excerpt {
    color: rgba(255,255,255,0.5) !important;
    font-size: 14px !important;
  }
  .pagefind-ui__result-link {
    text-decoration: none !important;
  }
  .pagefind-ui__message {
    color: rgba(255,255,255,0.4) !important;
    font-size: 14px !important;
  }
  .pagefind-ui__button {
    background: rgba(99,102,241,0.15) !important;
    border: 1px solid rgba(99,102,241,0.3) !important;
    color: #818CF8 !important;
    border-radius: 8px !important;
    padding: 8px 16px !important;
  }
  .pagefind-ui__button:hover {
    background: rgba(99,102,241,0.25) !important;
  }
  /* 清除搜索框右侧按钮 */
  .pagefind-ui__search-clear {
    color: rgba(255,255,255,0.4) !important;
  }
</style>

<script>
  import { PagefindUI } from '@pagefind/default-ui';

  window.addEventListener('DOMContentLoaded', () => {
    new PagefindUI({
      element: '#search',
      showSubResults: false,
      showImages: false,
      translations: {
        placeholder: '搜索 Skill 名称、标签、分类...',
        zero_results: '未找到相关 Skill，换个关键词试试',
        many_results: '找到 [COUNT] 个相关结果',
        one_result: '找到 1 个相关结果',
        load_more: '加载更多',
        searching: '搜索中...',
      },
    });
  });
</script>
